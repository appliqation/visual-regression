# appq connection — same account/org credentials the rest of the family uses.
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# Set exactly one LLM provider. Anthropic preferred if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=
OPENAI_MODEL=
ANTHROPIC_MAX_TOKENS=8192
OPENAI_MAX_OUTPUT_TOKENS=8192

# Overall tool-calling loop budget for one `check` run — deliberately tight:
# the mechanical work (two navigations, one diff) is fixed cost inside a
# single capture_and_diff call, the model's only real work is one judgment.
BUDGET_MAX_CALLS=15
BUDGET_MAX_PAGES=10
BUDGET_MAX_MILLIS=300000
BUDGET_MAX_TURNS=10
# Broad backstop against runaway spend, not a tuned budget. Includes cache
# tokens — matters more here than most siblings, since every turn after
# capture_and_diff carries three real images in context.
BUDGET_MAX_TOTAL_TOKENS=1000000

# Playwright browser tools' evidence ring-buffer cap. Unused in practice —
# this agent never exposes browser_* tools to the model, capture_and_diff
# drives its own browser directly — kept for config-shape consistency.
RING_BUFFER_CAP=10

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=
