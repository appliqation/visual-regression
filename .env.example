# appq connection — same account/org credentials the rest of the family uses.
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# Set exactly one LLM provider — checked in this order, first configured
# wins: Anthropic, OpenAI, DeepSeek, GLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=
OPENAI_MODEL=
ANTHROPIC_MAX_TOKENS=8192
OPENAI_MAX_OUTPUT_TOKENS=8192

# DeepSeek and Zhipu's GLM — both OpenAI Chat Completions-compatible, routed
# through the same generic adapter. Unlike Anthropic/OpenAI, there is no
# built-in default model here — DEEPSEEK_MODEL/GLM_MODEL are REQUIRED when
# that provider is selected (model IDs on both move fast; a silently stale
# hardcoded default would be worse than an explicit startup error). Base
# URLs default to the public endpoints — override only for a proxy/self-host.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MAX_TOKENS=8192
# Vision note (verified against this repo's own code, not assumed): unlike
# appliqation-autopilot, this DOES matter here. captureAndDiff.ts attaches
# three real screenshots (baseline, target, diff overlay) to the tool result
# every run, and they really do reach the model as LlmMessage.images — see
# engine/loop.ts pushing `images: result.images` onto the tool message, then
# each provider adapter (including openaiCompatible.ts) embedding them as
# real image content. DeepSeek's chat models are text-only (images will be
# sent but the model cannot see them), and not every GLM model supports
# vision — pick a vision-capable model (e.g. a GLM-4V variant) if you use
# either provider here; a text-only model will still run but its judgment
# won't actually be based on the screenshots.

# Overall tool-calling loop budget for one `check` run — deliberately tight:
# the mechanical work (two navigations, one diff) is fixed cost inside a
# single capture_and_diff call, the model's only real work is one judgment.
BUDGET_MAX_CALLS=15
BUDGET_MAX_PAGES=10
BUDGET_MAX_MILLIS=300000
BUDGET_MAX_TURNS=10
# Broad backstop against runaway spend, not a tuned budget. Includes cache
# tokens — matters more here than most siblings, since every turn after
# capture_and_diff carries three real images in context.
BUDGET_MAX_TOTAL_TOKENS=1000000

# Playwright browser tools' evidence ring-buffer cap. Unused in practice —
# this agent never exposes browser_* tools to the model, capture_and_diff
# drives its own browser directly — kept for config-shape consistency.
RING_BUFFER_CAP=10

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=
